{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": "."
  },
  "include": [
    "./src/**/*",
    "./controllers/**/*",
    "./models/**/*",
    "./routes/**/*",
    "./middlewares/**/*",
    "./config/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
